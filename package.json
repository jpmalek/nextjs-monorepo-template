{
  "private": true,
  "name": "nextjs-monorepo",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-pnpm.js",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "turbo run start",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "prepare": "husky",
    "release": "changeset version && changeset publish",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "check-types": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" exec tsc --noEmit",
    "teardown": "./scripts/teardown.sh",
    "reset-packages": "./scripts/reset-pnpm-packages.sh"
  },
  "engines": {
    "node": "24"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "16.0.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.2",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-next": "^0.0.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "jsdom": "^27.3.0",
    "next": "16.0.10",
    "node-fetch": "^3.3.2",
    "pnpm": "^10.25.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "webpack": "^5.103.0"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
