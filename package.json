{
  "private": true,
  "name": "nextjs-monorepo",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-pnpm.js",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "turbo run start",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "prepare": "husky",
    "release": "changeset version && changeset publish",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "check-types": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" exec tsc --noEmit",
    "teardown": "./scripts/teardown.sh",
    "reset-packages": "./scripts/reset-pnpm-packages.sh"
  },
  "engines": {
    "node": "24"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "15.4.4",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-next": "^0.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "jsdom": "^26.1.0",
    "next": "15.4.4",
    "node-fetch": "^3.3.2",
    "pnpm": "^10.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.11",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "webpack": "^5.101.0"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
